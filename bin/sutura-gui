#!/usr/bin/env bash
# Sutura GUI launcher (P10 transition): Rust GUI by default, Python GUI under
# SUTURA_BACKEND=python (or --backend python).
set -u

APP_DIR="${SUTURA_APP_DIR:-$HOME/.local/share/sutura}"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
SELF="$SELF_DIR/$(basename "${BASH_SOURCE[0]:-$0}")"
SOURCE_ROOT="$(cd "$SELF_DIR/.." 2>/dev/null && pwd || true)"

backend="${SUTURA_BACKEND:-rust}"
args=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        --backend)
            if [ "$#" -lt 2 ]; then
                echo "sutura-gui: --backend needs rust or python" >&2
                exit 2
            fi
            backend="$2"; shift 2 ;;
        --backend=*)
            backend="${1#*=}"; shift ;;
        *)
            args+=("$1"); shift ;;
    esac
done
case "$backend" in
    rust|python) ;;
    *) echo "sutura-gui: invalid backend '$backend' (expected rust or python)" >&2; exit 2 ;;
esac

# An auto-discovered Rust entry point must be a real binary, not the legacy
# Python .app launcher (a shell script named Contents/MacOS/sutura).
is_rust_binary() {
    [ -x "$1" ] || return 1
    [ "$(head -c 2 "$1" 2>/dev/null || true)" != '#!' ]
}

PY_CMD=()
collect_python_gui() {
    if [ -x "$APP_DIR/sutura-gui-py" ]; then
        PY_CMD=("$APP_DIR/sutura-gui-py")
        return 0
    fi
    if [ -n "${SUTURA_PYTHON:-}" ] && [ -x "$SUTURA_PYTHON" ] && [ -f "$APP_DIR/gui.py" ]; then
        PY_CMD=("$SUTURA_PYTHON" "$APP_DIR/gui.py")
        return 0
    fi
    for py in "$APP_DIR/venv/bin/python" \
              "$HOME/miniforge3/envs/sutura-env/bin/python" \
              "$HOME/miniconda3/envs/sutura-env/bin/python" \
              "$HOME/anaconda3/envs/sutura-env/bin/python"; do
        if [ -x "$py" ] && [ -f "$APP_DIR/gui.py" ]; then
            PY_CMD=("$py" "$APP_DIR/gui.py")
            return 0
        fi
    done
    if [ -n "$SOURCE_ROOT" ] && [ -f "$SOURCE_ROOT/sutura/gui.py" ]; then
        py="${SUTURA_PYTHON:-python3}"
        if command -v "$py" >/dev/null 2>&1; then
            PY_CMD=("$py" "$SOURCE_ROOT/sutura/gui.py")
            return 0
        fi
    fi
    return 1
}

if [ "$backend" = "python" ]; then
    if ! collect_python_gui; then
        echo "sutura-gui: Python backend requested but no legacy Python install was found" >&2
        exit 1
    fi
    exec env SUTURA_BACKEND=python "${PY_CMD[@]}" "${args[@]}"
fi

candidates=()
if [ -n "${SUTURA_RUST_GUI:-}" ] && [ -x "$SUTURA_RUST_GUI" ] && [ "$SUTURA_RUST_GUI" != "$SELF" ]; then
    exec "$SUTURA_RUST_GUI" "${args[@]}"
fi
candidates+=("$APP_DIR/bin/sutura-gui")
candidates+=("$HOME/Applications/Sutura.app/Contents/MacOS/sutura-gui")
candidates+=("/Applications/Sutura.app/Contents/MacOS/sutura-gui")
[ -n "$SOURCE_ROOT" ] && candidates+=("$SOURCE_ROOT/rust/target/release/sutura-gui")
for cand in "${candidates[@]}"; do
    if [ -n "$cand" ] && [ "$cand" != "$SELF" ] && is_rust_binary "$cand"; then
        exec "$cand" "${args[@]}"
    fi
done

if collect_python_gui; then
    exec env SUTURA_BACKEND=rust "${PY_CMD[@]}" "${args[@]}"
fi

echo "sutura-gui: no Rust GUI or Python fallback was found" >&2
exit 1

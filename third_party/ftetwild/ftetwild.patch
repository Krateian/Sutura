-        set(GEO_PLATFORM "Linux64-gcc")
+        # Arch-aware: the x86_64 Geogram configs inject -m64, which GCC rejects
+        # on arm64 ("unrecognized command-line option"), so a hard-coded
+        # Linux64-gcc breaks every non-x86 Linux build.
+        if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|amd64|AMD64")
+            set(GEO_PLATFORM "Linux64-gcc")
+        elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+            set(GEO_PLATFORM "Linux64-nonx86-clang-dynamic")
+        else()
+            set(GEO_PLATFORM "Linux64-nonx86-gcc-dynamic")
+        endif()
     endif()
 
     set(VORPALINE_PLATFORM ${GEO_PLATFORM})

diff --git a/src/tbb_shim/oneapi/tbb.h b/src/tbb_shim/oneapi/tbb.h
new file mode 100644
index 0000000..e5cf5cc
--- /dev/null
+++ b/src/tbb_shim/oneapi/tbb.h
@@ -0,0 +1,36 @@
+#pragma once
+#include <vector>
+#include <algorithm>
+#include <unordered_set>
+#include <cstddef>
+
+namespace tbb {
+    template<typename T>
+    using concurrent_vector = std::vector<T>;
+
+    template<typename T>
+    using concurrent_unordered_set = std::unordered_set<T>;
+
+    template<typename Index, typename Function>
+    inline void parallel_for(Index first, Index last, const Function& f) {
+        for (Index i = first; i < last; ++i) {
+            f(i);
+        }
+    }
+
+    template<typename RandomIt>
+    inline void parallel_sort(RandomIt first, RandomIt last) {
+        std::sort(first, last);
+    }
+
+    struct global_control {
+        enum parameter { max_allowed_parallelism, thread_stack_size };
+        global_control(parameter, size_t) {}
+    };
+}
+
+namespace oneapi {
+    namespace tbb {
+        using namespace ::tbb;
+    }
+}

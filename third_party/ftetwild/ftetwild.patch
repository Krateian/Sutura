@@ -29,9 +29,20 @@ namespace floatTetWild {
 class Random
 {
 public:
-    static int next(int min, int max)
+    static std::mt19937& get_gen()
     {
         static std::mt19937 gen(42);
+        return gen;
+    }
+
+    static void reset(unsigned int seed = 42)
+    {
+        get_gen().seed(seed);
+    }
+
+    static int next(int min, int max)
+    {
+        auto& gen = get_gen();
         int res = (gen()-std::mt19937::min())/double(std::mt19937::max()-std::mt19937::min())*(max-min)+min;
 
         return res;
